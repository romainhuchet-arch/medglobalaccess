# Aucune clé d'API nécessaire (Melodi et geo.api.gouv.fr sont ouverts).
DEPARTEMENT=44

# Fichier BPE : vide = dernier fichier CSV lu dans le catalogue Melodi (recommandé)
BPE_FILE_ID=
# Code BPE du généraliste (les autres professions sont détectées : voir professions.py)
BPE_CODE_GENERALISTE=D265

# Distance de recours des généralistes (km) ; autres professions en JSON
RAYON_KM=30
# RAYONS_KM={"pharmacies": 12, "infirmiers": 15}

# Sous-dotée en dessous de cette fraction de la moyenne du département
SEUIL_RATIO=0.667

# true = données simulées (hors ligne)
FORCE_SYNTHETIC=false
